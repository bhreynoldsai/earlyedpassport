# Copy to .env.local and fill in. Never commit .env.local.
#
# ---------------------------------------------------------------------------
# NEVER POINT A DEV MACHINE AT PRODUCTION.
# NO REAL CHILD DATA IN STAGING, EVER — SEED DATA ONLY.
# ---------------------------------------------------------------------------

# Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. This key bypasses row level security completely.
# It must never appear in a NEXT_PUBLIC_ variable — next.config.ts throws at
# build time if it does. It is used by exactly two things: the GELDS import
# pipeline and the seed script.
SUPABASE_SERVICE_ROLE_KEY=

# Throwaway Postgres for the RLS test suite. Without this the RLS tests SKIP,
# and a green run that skipped them proves nothing.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
