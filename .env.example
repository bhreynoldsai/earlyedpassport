# Copy to .env.local and fill in. Never commit .env.local.
#
# Full setup, including which of these belong in Vercel: docs/SUPABASE-SETUP.md
#
# ---------------------------------------------------------------------------
# NEVER POINT A DEV MACHINE AT PRODUCTION.
# NO REAL CHILD DATA IN STAGING, EVER — SEED DATA ONLY.
# ---------------------------------------------------------------------------

# Safe to expose to the browser: row level security, not secrecy, is what
# protects the data behind these.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Supabase renamed this key. New projects issue `sb_publishable_...` under
# PUBLISHABLE_KEY; older ones issue a JWT under ANON_KEY. Either name works —
# see lib/supabase/env.ts. Set one of them.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. This key bypasses row level security completely.
#
# It must never appear in a NEXT_PUBLIC_ variable — next.config.ts throws at
# build time if it does — and never in a chat message or a commit. In hosted
# environments it belongs in Vercel's environment settings and nowhere else.
#
# Exactly two things use it: the GELDS import pipeline and the seed script.
# SUPABASE_SECRET_KEY is accepted as an alias for projects issuing `sb_secret_`.
SUPABASE_SERVICE_ROLE_KEY=

# Throwaway Postgres. Used by two things:
#   - the RLS test suite. Without this the RLS tests SKIP, and a green run that
#     skipped them proves nothing.
#   - `pnpm db:verify` / `pnpm db:types`, which rebuild the schema from zero in
#     a scratch database to prove the migrations still apply in order.
# `supabase start` serves one on 54322.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
